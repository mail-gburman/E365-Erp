[Unit]
Description=KPS ERP Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/kps_erp/kps-erp-v8_9_10/backend
EnvironmentFile=/opt/kps_erp/.env
ExecStart=/opt/kps_erp/kps-erp-v8_9_10/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
