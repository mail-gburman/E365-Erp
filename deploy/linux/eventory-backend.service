[Unit]
Description=E365 ERP Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/e365_erp/e365-erp-v8_9_10/backend
EnvironmentFile=/opt/e365_erp/.env
ExecStart=/opt/e365_erp/e365-erp-v8_9_10/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
