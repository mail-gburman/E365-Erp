{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index.py" }
  ]
}
